# PortMind AI — Backend Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/portmind

# Authentication (demo credentials for hackathon MVP)
JWT_SECRET=change_this_to_a_random_secret_in_production
DEMO_USERNAME=admin
DEMO_PASSWORD=portmind2026

# IBM watsonx.ai
AI_PROVIDER=watsonx
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
